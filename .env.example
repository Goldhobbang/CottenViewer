# Discord Bot Token
# https://discord.com/developers/applications 에서 발급받은 토큰 복사 붙여넣기
DISCORD_TOKEN=your_discord_token_here

# Ollama LLM 엔드포인트 (로컬 PC 또는 원격 터널)
# 로컬 개발: http://localhost:11434/v1 (생략 시 자동 기본값)
# ngrok 터널: https://xxxx.ngrok-free.app/v1
# Cloudflare Tunnel: https://xxxx.tunnel.cloudflare.net/v1
OLLAMA_BASE_URL=https://your_tunnel_url/v1
